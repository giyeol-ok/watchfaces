      <MinuteHand resource="minute_hand" x="205" y="59" width="40" height="186" pivotX="0.4963" pivotY="0.8918" />
      <HourHand resource="hour_hand" x="193" y="108" width="64" height="149" pivotX="0.4982" pivotY="0.7839" />
    </AnalogClock>
  </Scene>
</WatchFace>
