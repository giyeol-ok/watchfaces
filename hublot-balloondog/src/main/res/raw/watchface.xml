    <!-- Date window at 3 o'clock, matching the black cutout printed in the dial art. -->
    <PartText x="339" y="200" width="31" height="27" pivotX="0.5" pivotY="0.5">
      <Text align="CENTER">
        <Font family="roboto_regular" size="20" weight="BOLD" slant="NORMAL" color="#FFFFFF">
          <Template>%d
            <Parameter expression="[DAY]" />
          </Template>
        </Font>
      </Text>
    </PartText>

    <!-- Hands: width narrowed to 80% (height unchanged, so this is an
