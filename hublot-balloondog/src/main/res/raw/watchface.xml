        </PartImage>
      </ListOption>
    </ListConfiguration>
    <!-- Dimmed, low-power dial shown only in ambient/AOD mode. -->
    <ListConfiguration id="dial_color">
      <ListOption id="0">
        <PartImage x="0" y="0" width="450" height="450" alpha="0">
          <Image resource="dial_red_aod" />
          <Variant mode="AMBIENT" target="alpha" value="255" />
