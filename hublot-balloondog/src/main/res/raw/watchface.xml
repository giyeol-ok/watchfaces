      <HourHand resource="hour_hand" x="202" y="120" width="46" height="134" pivotX="0.4982" pivotY="0.7839" />
      <MinuteHand resource="minute_hand" x="211" y="76" width="29" height="167" pivotX="0.4963" pivotY="0.8918" />
      <SecondHand resource="second_hand" x="205" y="59" width="42" height="242" pivotX="0.4683" pivotY="0.6852">
        <Sweep frequency="SYNC_TO_DEVICE" />
        <Variant mode="AMBIENT" target="alpha" value="0" />
      </SecondHand>
    </AnalogClock>
  </Scene>
