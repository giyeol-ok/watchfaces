    <!-- Date window: tilted ~45 degrees between 4 and 5 o'clock in the dial
         art, so the day-of-month text is rotated to match. Every colorway
         shares the same pale window position, so one shared PartText pair
         covers all of them (black text in active mode; the window art
         darkens along with the AOD dial, so a white variant takes over in
         ambient, matching the lucea date-window pattern). -->
    <PartText x="285" y="291" width="32" height="24" pivotX="0.5" pivotY="0.5">
      <Transform target="angle" value="-45" />
      <Text align="CENTER" verticalAlign="CENTER">
